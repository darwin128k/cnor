# Fixed-storage records and nominal enum types.
enum State:
    idle
    active

struct Player:
    hp: i32
    state: State

fn damage(p: Player, amount: i32):
    p.hp -= amount

let mut player = Player(100, State.idle)
damage(player, 10)
player.state = State.active
println("hp =", player.hp)

match player.state:
    State.idle => println("idle"),
    State.active => println("active"),
